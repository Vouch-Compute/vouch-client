# AppArmor profile for the Vouch Compute job runner (installed by the .deb to /etc/apparmor.d/vouchcompute-runner).
# Ubuntu 24.04+ restricts unprivileged user namespaces; this profile grants `userns` to the runner only,
# so pool-core can start it in an empty network namespace, and denies network and user files on top of
# the runner's own Landlock + seccomp rules.
# The path is where the .deb installs the runner (/usr/bin), and the data dir follows the bundle id.
abi <abi/4.0>,
include <tunables/global>

profile vouchcompute-runner /usr/bin/pool-runner flags=(enforce) {
  include <abstractions/base>

  userns,

  # no network at all
  deny network,

  # the runner binary and libraries
  /usr/bin/pool-runner mr,
  /{usr/,}lib{,32,64}/** mr,

  # read-only model cache (verified bundles); nothing else under home
  owner @{HOME}/.local/share/com.vouchcompute.app{,.dev}/models/** r,
  deny @{HOME}/** w,
  deny /tmp/** w,

  # CPU topology for thread pools
  @{PROC}/@{pid}/** r,
  /sys/devices/system/cpu/** r,
  /sys/fs/cgroup/** r,

  # GPU device nodes (CUDA / DRI backends)
  /dev/nvidia* rw,
  /dev/dri/** rw,
}
